# LLM / NVIDIA
NVIDIA_API_KEY=                 # build.nvidia.com (créditos grátis)
NEMOTRON_MODEL_FAST=nvidia/llama-3.1-nemotron-nano-8b
NEMOTRON_MODEL_REASON=nvidia/llama-3.3-nemotron-super-49b
NV_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
NV_RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2

# NIM self-hosted (GPU local) — opcional no build, usado no F6
NIM_BASE_URL=http://localhost:8000/v1

# Reranker: nemo (default no build) | cohere (somente validação F7)
RERANKER_PROVIDER=nemo
COHERE_API_KEY=                 # só na F7 (trial gratuita)

# Busca / scraping
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Dados
POSTGRES_URL=postgresql://tapi:tapi@localhost:5432/tapi
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Observabilidade
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Auth da ferramenta (gate interno — F5.9). Token compartilhado p/ API + UI.
TAPI_API_TOKEN=
